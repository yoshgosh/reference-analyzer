# 必須（Notion の内部コネクションのトークンと，登録先のデータソースID）
NOTION_TOKEN=
NOTION_DATA_SOURCE_ID=

# Slack（Web API．Bot Token Scopes に chat:write を付与し，投稿先チャンネルにアプリを招待する）
SLACK_BOT_TOKEN=
SLACK_CHANNEL=          # チャンネルID を推奨（例 C0123ABCDEF）．名前（#name）でも動く

# 任意（コメントアウト時は既定値を使う）

# PAPER_ROOT は ~/Documents・~/Desktop・~/Downloads 配下に置けない．
# launchd から起動したスクリプトは，これらのディレクトリを列挙・読取できない（macOS の TCC）．
#PAPER_ROOT=$HOME/Research/Papers

#PAPER_INBOX_DIR=$PAPER_ROOT/inbox              # 自動処理の置き場（launchd が監視する）
#PAPER_IN_PROGRESS_DIR=$PAPER_ROOT/in_progress  # 取り込んだが直下へ出ていないPDF
#PAPER_WORK_DIR=$PAPER_ROOT/.work               # 1実行ごとの作業ディレクトリ
#PAPER_LOG_DIR=$PAPER_ROOT/.logs                # 実行記録

#PAPER_ENGINE=claude       # claude のみ（codex は未実装）
#PAPER_MODEL=opus          # opus / sonnet / fable / haiku（節約したい場合は sonnet）
#PAPER_EFFORT=medium       # low / medium / high / xhigh / max

#PAPER_PARALLEL=2          # 同時に処理する資料の数（手動と自動の合計）
#PAPER_LOG_RETENTION_DAYS=7

#PAPER_SETTLE_SECONDS=2    # inbox のファイルサイズがこの秒数変化しないことを確認してから取り込む
#PAPER_MAX_ROUNDS=20       # 処理後に inbox を再走査する上限回数

#PAPER_AUX_MAX_FILES=100   # --with で渡せる補助資料の上限（ファイル数）
#PAPER_AUX_MAX_BYTES=52428800   # 同（バイト数．既定 50MB）
