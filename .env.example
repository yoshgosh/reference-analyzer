# 必須
NOTION_DATA_SOURCE_ID=

# Slack（Web API を使う．Incoming Webhook は ts を返さず書き換えができない）
#   Bot Token Scopes に chat:write を付与し，投稿先チャンネルにアプリを招待する
SLACK_BOT_TOKEN=
SLACK_CHANNEL=          # チャンネルID を推奨（例 C0123ABCDEF）．名前（#name）でも動く

# 任意（コメントアウト時は既定値を使用）
# PAPER_ROOT は ~/Documents 配下に置いてはならない．
# launchd から起動したスクリプトは TCC により ~/Documents の列挙・読取ができない．
#PAPER_ROOT=$HOME/Research/Papers
#PAPER_INBOX_DIR=$PAPER_ROOT/inbox
#PAPER_FAILED_DIR=$PAPER_ROOT/failed
#PAPER_WORK_DIR=$PAPER_ROOT/.work
#PAPER_LOG_DIR=$PAPER_ROOT/.logs
#PAPER_ENGINE=claude
#PAPER_MODEL=opus          # opus / sonnet / fable / haiku（節約したい場合は sonnet）
#PAPER_EFFORT=medium       # low / medium / high / xhigh / max
#PAPER_PARALLEL=2
#PAPER_LOG_RETENTION_DAYS=7
