#!/usr/bin/env bash
# reference-analyzer 手動コマンド
#
#   ref <対象>                        対象を1つ処理する（PDFファイル または URL）
#   ref <対象> --with <補助資料...>   同じ文献を補助する資料を添えて処理する
#   ref --resume <run_id>             失敗した実行を，AI を再実行せずに止まったステップから続ける
#                                     （解析が済んでいる場合のみ．登録・改名・移動を行う）
#
# 1コマンド = 1文献 = AI プロセス1回 = Notion 1ページ．
# 補助資料はファイル・フォルダ・URL を混在できる．フォルダは展開せず，
# 同じ文献を補助する資料としてまとめて1度の AI プロセスに渡す（順次処理しない）．
#
# 対象がPDFの場合，成功するとそのPDFを Citation Key に改名する．移動はしない．
# 失敗した場合は元のファイルに一切触らない．
# inbox 配下のファイルは指定できない（自動処理の持ち場である）．
#
# macOS 標準の bash 3.2 で動くように書いている．
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$REPO_ROOT/lib/core.sh"

usage() {
  sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
}

case "${1:-}" in
  ''|-h|--help|help) usage; exit "$([ -z "${1:-}" ] && echo 2 || echo 0)" ;;
esac

# ---------------------------------------------------------------- 結果の表示

# 標準出力のラベルは通知と同じ語彙を使う（語を二重に持たない）
report_completed() {
  echo "Completed: ${TITLE}"
  echo "citation_key: ${CITATION_KEY}"
  echo "notion: ${NOTION_URL}"
  if [ "$TARGET_KIND" = url ]; then
    echo "url: ${TARGET_LABEL}"
  elif [ -n "${CURRENT_PATH:-}" ]; then
    echo "file: ${CURRENT_PATH}"
  fi
  [ -n "${GUARD_WARNING:-}" ] && echo "warning: ${GUARD_WARNING}"
  return 0
}

report_failed() {
  {
    echo "Failed: ${TITLE:-$TARGET_LABEL}"
    printf '%s\n' "$(steps_log | tr ' ' '\n' | sed 's/^/  /')"
    echo "error: ${ERROR_MESSAGE:-不明}"
    local next; next="$(next_action)"
    [ -n "$next" ] && echo "next: ${next}"
    [ -n "${NOTION_URL:-}" ] && echo "notion: ${NOTION_URL}"
    [ "$TARGET_KIND" = file ] && [ -n "${CURRENT_PATH:-}" ] && echo "file: ${CURRENT_PATH}"
    echo "log: ${RECORD_DIR}"
  } >&2
  return 0
}

# ---------------------------------------------------------------- 再開

has_step() { case " $STEP_LIST " in *" $1 "*) return 0 ;; esac; return 1; }

# 解析の結果（result.json と代表画像）は記録ディレクトリに残っている．それを使い，
# 元の実行で completed にならなかったステップ（create・rename・move）から続ける．
# AI は起動しない．記録は PAPER_LOG_RETENTION_DAYS（既定7日）で消えるので，それまでに行う．
#
# 通知には元の経路のステップを全部並べる（番号が元の通知と一致する）．
resume_run() {  # <run_id>
  local page state s

  RUN_ID="$1"
  RECORD_DIR="$PAPER_LOG_DIR/$RUN_ID"
  RESULT_JSON="$RECORD_DIR/result.json"
  page="$RECORD_DIR/notion_page.json"
  state="$RECORD_DIR/state.json"
  if [ ! -d "$RECORD_DIR" ]; then
    echo "実行記録が見つからない（run_id の誤りか，保存期間を過ぎた）: $RECORD_DIR" >&2
    exit 1
  fi
  if [ ! -f "$RESULT_JSON" ] || [ ! -f "$RECORD_DIR/target.json" ] ||
     [ "$(json_get "$RESULT_JSON" status)" != success ]; then
    echo "この実行は解析に失敗しているので再開できない．対象を処理し直せ: $RUN_ID" >&2
    # 自動なら in_progress に残っているので inbox へ戻す．手動は元のコマンドを打ち直す
    # （--with を付けていた場合は同じく付ける）
    s="$(json_get "$RECORD_DIR/state.json" current_path)"
    [ -z "$s" ] && s="$(json_get "$RECORD_DIR/target.json" path)"
    if [ "$(json_get "$RECORD_DIR/target.json" kind)" = url ]; then
      echo "next: ref $(shell_path "$(json_get "$RECORD_DIR/target.json" url)")" >&2
    elif [ "$(json_get "$RECORD_DIR/target.json" mode)" = auto ]; then
      echo "next: mv $(shell_path "$s") $(shell_path "$PAPER_INBOX_DIR")/" >&2
    elif [ -n "$s" ]; then
      echo "next: ref $(shell_path "$s")" >&2
    fi
    exit 1
  fi

  TARGET_KIND="$(json_get "$RECORD_DIR/target.json" kind)"
  TARGET_LABEL="$(json_get "$RECORD_DIR/target.json" label)"
  CITATION_KEY="$(json_get "$RESULT_JSON" citation_key)"
  TITLE="$(json_get "$RESULT_JSON" title)"
  GUARD_WARNING=""

  # 元の経路のステップ
  if [ "$TARGET_KIND" = url ]; then
    STEP_LIST="analyze create"
  elif [ "$(json_get "$RECORD_DIR/target.json" mode)" = auto ]; then
    STEP_LIST="fetch analyze create rename move"
  else
    STEP_LIST="analyze create rename"
  fi
  RUN_MODE=resume

  # 済んだステップを引き継ぐ．解析は result.json が success なので済んでいる．
  # state.json が無い古い記録では，ページの有無だけから判断する
  has_step fetch && step_completed fetch
  step_completed analyze
  for s in $(py -c '
import json, sys
try:
    steps = json.load(open(sys.argv[1], encoding="utf-8"))["steps"]
except Exception:
    steps = {}
print(" ".join(k for k, v in steps.items() if v == "completed"))
' "$state"); do
    step_completed "$s"
  done

  # ページ：完成していれば create は済んでいる．作りかけなら捨ててから作り直す
  if [ -f "$page" ]; then
    if [ "$(json_get "$page" complete)" = True ]; then
      step_completed create
      NOTION_URL="$(json_get "$page" url)"
    elif ! py "$REPO_ROOT/lib/notion.py" discard "$RECORD_DIR"; then
      echo "作りかけのページを捨てられなかった: $(json_get "$page" url)" >&2
      echo "Notion でそのページを削除し，$page を消してから再実行せよ" >&2
      exit 1
    fi
  fi

  if steps_all_completed; then
    echo "この実行は既に完了している: $RUN_ID" >&2
    exit 0
  fi

  # ファイルはいまの場所から動かす（改名済みで移動だけが残っている場合がある）
  CURRENT_PATH="$(json_get "$state" current_path)"
  [ -z "$CURRENT_PATH" ] && CURRENT_PATH="$(json_get "$RECORD_DIR/target.json" path)"
  TARGET_PATH="$CURRENT_PATH"
  if [ "$TARGET_KIND" = file ]; then
    if [ "$(step_state rename)" != completed ] || { has_step move && [ "$(step_state move)" != completed ]; }; then
      if [ ! -f "$CURRENT_PATH" ]; then
        echo "対象ファイルが見つからない: $CURRENT_PATH" >&2
        echo "場所を移した場合は，手で改名・移動せよ（Citation Key: $CITATION_KEY）" >&2
        exit 1
      fi
    fi
    LOCK_PATH="$(target_lock_path file "$CURRENT_PATH")"
    if ! acquire_lock "$LOCK_PATH" 5; then
      echo "この資料は処理中である: $(basename "$CURRENT_PATH")" >&2
      LOCK_PATH=""
      exit 1
    fi
  fi

  RUN_LOG="$RECORD_DIR/run.log"
  STARTED_AT="$(date '+%s')"
  log_msg "---- 再開する（ref --resume）: $(steps_log) ----"
  notify_start

  # 前のステップが成功したときだけ次へ進む（create が済まないうちに改名しない）
  if [ "$(step_state create)" = completed ] || create_page; then
    if has_step rename && [ "$(step_state rename)" != completed ]; then
      rename_step 1 || true
    fi
    if has_step move && [ "$(step_state rename)" = completed ] && [ "$(step_state move)" != completed ]; then
      move_step || true
    fi
  fi

  save_state
  log_msg "ステップ: $(steps_log)"
  notify_result
  if steps_all_completed; then
    report_completed
    exit 0
  fi
  report_failed
  exit 1
}

# ---------------------------------------------------------------- 引数

TARGET="$1"; shift

RESUME_RUN_ID=""
if [ "$TARGET" = "--resume" ]; then
  if [ "$#" -ne 1 ]; then
    echo "使い方: ref --resume <run_id>" >&2
    exit 2
  fi
  RESUME_RUN_ID="$1"; shift
fi

AUX_ARGS=()
if [ "$#" -gt 0 ]; then
  if [ "$1" != "--with" ]; then
    echo "対象は1つだけ指定せよ: $1" >&2
    echo "補助資料を添える場合は --with を使う:  ref <対象> --with <補助資料...>" >&2
    echo "（2本の文献を登録したい場合は ref を2回実行せよ．" >&2
    echo "  --with を省くと，2本目が1本目の補助資料として同じページに混ざる）" >&2
    exit 2
  fi
  shift
  if [ "$#" -eq 0 ]; then
    echo "--with の後に補助資料を1つ以上指定せよ" >&2
    exit 2
  fi
  while [ "$#" -gt 0 ]; do
    AUX_ARGS[${#AUX_ARGS[@]}]="$1"
    shift
  done
fi

load_env || exit 1

LOCK_PATH=""
cleanup_on_exit() {
  release_slot 2>/dev/null || true
  [ -n "$LOCK_PATH" ] && release_lock "$LOCK_PATH"
  # set -e の下では，終了時の処理の最後の終了コードが exit の値を上書きする
  return 0
}
trap cleanup_on_exit EXIT

[ -n "$RESUME_RUN_ID" ] && resume_run "$RESUME_RUN_ID"

# ---------------------------------------------------------------- 対象の判別

RUN_MODE=manual

case "$TARGET" in
  http://*|https://*)
    TARGET_KIND=url
    TARGET_LABEL="$TARGET"
    # URL は改名する対象が無い
    STEP_LIST="analyze create"
    CURRENT_PATH=""
    ;;
  *)
    if [ ! -f "$TARGET" ]; then
      echo "ファイルが見つからない: $TARGET" >&2
      exit 2
    fi
    case "$(printf '%s' "$TARGET" | tr 'A-Z' 'a-z')" in
      *.pdf) ;;
      *) echo "PDF ではない: $TARGET" >&2; exit 2 ;;
    esac
    TARGET_KIND=file
    TARGET_PATH="$(cd "$(dirname "$TARGET")" && pwd)/$(basename "$TARGET")"
    TARGET_LABEL="$(basename "$TARGET_PATH")"
    # inbox は自動処理の持ち場である．ここを手動で指すと，自動が取り込みのために
    # mv した瞬間に対象が消える（ロックの取得順も経路間で逆になる）．
    case "$TARGET_PATH" in
      "$PAPER_INBOX_DIR"/*)
        echo "inbox のファイルは指定できない: $TARGET_LABEL" >&2
        echo "inbox は自動処理の持ち場である．自動の完了を待つか，外に出してから指定せよ．" >&2
        exit 2 ;;
    esac
    # 手動は原本をその場で改名するだけで，移動はしない
    STEP_LIST="analyze create rename"
    CURRENT_PATH="$TARGET_PATH"
    ;;
esac

# ---------------------------------------------------------------- 補助資料の検査

# 作業ディレクトリへコピーするため，巨大なフォルダを指定された場合は
# AI を起動する前に中止する（利用量を消費しない）．
AUX_FILES=()      # コピーするローカルのパス
AUX_URLS=()       # プロンプトに列挙する URL
AUX_BYTES=0
AUX_COUNT=0

add_aux_file() {  # <ファイルのパス>
  local f="$1" sz
  sz="$(stat -f '%z' "$f" 2>/dev/null || echo 0)"
  AUX_FILES[${#AUX_FILES[@]}]="$f"
  AUX_BYTES=$((AUX_BYTES + sz))
  AUX_COUNT=$((AUX_COUNT + 1))
}

for a in ${AUX_ARGS[@]+"${AUX_ARGS[@]}"}; do
  case "$a" in
    http://*|https://*)
      AUX_URLS[${#AUX_URLS[@]}]="$a"
      ;;
    *)
      if [ -d "$a" ]; then
        while IFS= read -r -d '' f; do
          case "$(basename "$f")" in .*) continue ;; esac
          add_aux_file "$f"
        done < <(find "$a" -type f -print0 2>/dev/null | sort -z)
      elif [ -f "$a" ]; then
        add_aux_file "$a"
      else
        echo "補助資料が見つからない: $a" >&2
        exit 2
      fi
      ;;
  esac
done

if [ "$AUX_COUNT" -gt "$PAPER_AUX_MAX_FILES" ]; then
  echo "補助資料が多すぎる: ${AUX_COUNT} ファイル（上限 ${PAPER_AUX_MAX_FILES}）" >&2
  echo "PAPER_AUX_MAX_FILES で変更できる" >&2
  exit 2
fi
if [ "$AUX_BYTES" -gt "$PAPER_AUX_MAX_BYTES" ]; then
  echo "補助資料が大きすぎる: $((AUX_BYTES / 1048576))MB（上限 $((PAPER_AUX_MAX_BYTES / 1048576))MB）" >&2
  echo "PAPER_AUX_MAX_BYTES で変更できる" >&2
  exit 2
fi

# ---------------------------------------------------------------- やり直しのコマンド

# 解析の前で失敗したときに next: に出す．どこからでも打てるよう，パスは絶対パスにする
abs_path() {  # <パス>
  case "$1" in
    http://*|https://*) printf '%s' "$1" ;;
    *) printf '%s/%s' "$(cd "$(dirname "$1")" && pwd)" "$(basename "$1")" ;;
  esac
}
REDO_COMMAND="ref $(shell_path "$(abs_path "$TARGET")")"
if [ "${#AUX_ARGS[@]}" -gt 0 ]; then
  REDO_COMMAND="$REDO_COMMAND --with"
  for a in "${AUX_ARGS[@]}"; do
    REDO_COMMAND="$REDO_COMMAND $(shell_path "$(abs_path "$a")")"
  done
fi

# ---------------------------------------------------------------- 補助資料の記述

AUX_DESC=""      # プロンプトに渡す一覧（全件）
AUX_SUMMARY=""   # 通知の with: に出す要約（50文字で打ち切る）
if [ "$AUX_COUNT" -gt 0 ] || [ "${#AUX_URLS[@]}" -gt 0 ]; then
  for f in ${AUX_FILES[@]+"${AUX_FILES[@]}"}; do
    AUX_DESC="${AUX_DESC}- ./aux/$(basename "$f")"$'\n'
    AUX_SUMMARY="${AUX_SUMMARY}${AUX_SUMMARY:+, }$(basename "$f")"
  done
  for u in ${AUX_URLS[@]+"${AUX_URLS[@]}"}; do
    AUX_DESC="${AUX_DESC}- URL: ${u}"$'\n'
    AUX_SUMMARY="${AUX_SUMMARY}${AUX_SUMMARY:+, }${u}"
  done
  # 文字数で数える（bash 3.2 の ${#var} はバイト数になりうる）
  AUX_SUMMARY="$(py -c '
import sys
t = sys.argv[1]
sys.stdout.write(t if len(t) <= 50 else t[:50] + "...")
' "$AUX_SUMMARY")"
fi

# ---------------------------------------------------------------- 経路ごとの2つの関数

# 補助資料は aux/ にまとめ，どれが対象かパスで分かるようにする．
# 対象そのもののコピーは共有側（stage_target）が行う．
prepare_target() {
  local f
  if [ "$AUX_COUNT" -gt 0 ]; then
    mkdir -p "$WORK_DIR/aux"
    for f in ${AUX_FILES[@]+"${AUX_FILES[@]}"}; do
      cp "$f" "$WORK_DIR/aux/$(basename "$f")" 2>/dev/null || log_msg "警告: 補助資料をコピーできなかった: $f"
    done
    log_msg "補助資料をコピーした: ${AUX_COUNT} ファイル（$((AUX_BYTES / 1024))KB）"
  fi
  [ "${#AUX_URLS[@]}" -gt 0 ] && log_msg "補助資料のURL: ${#AUX_URLS[@]} 件"
  return 0
}

# 原本をその場で改名するだけで，移動はしない（rename_step が共有の本体）．
# 失敗した場合は原本に触らない．
place_result() {  # <解析と登録が成功なら1>
  rename_step "$1" || return 0
  return 0
}

# ---------------------------------------------------------------- 実行

# 同じ資料への多重実行を弾く（原本を移動しないため mv による取り込みができない）
LOCK_PATH="$(target_lock_path "$TARGET_KIND" "${TARGET_PATH:-$TARGET}")"
if ! acquire_lock "$LOCK_PATH" 5; then
  echo "この資料は既に処理中である: $TARGET_LABEL" >&2
  LOCK_PATH=""
  exit 1
fi

cleanup_old_records || true

if run_one; then
  report_completed
  exit 0
fi
report_failed
exit 1
